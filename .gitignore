# ==========================================================================================
# Third party binaries - NOT redistributed
# ==========================================================================================
# This port is built from TerraFirmaCraft's data and assets, and EUPL-1.2 (the licence both this mod and TFC use)
# does not turn TerraFirmaCraft, Farmer's Delight or Kaleidoscope Cookery into something this repository may
# redistribute. Those jars are inputs to the generator scripts in tools/, so they stay on the machine that runs
# those scripts and never enter the repository.
*.jar
*.zip
*.war
*.nar
*.ear
*.tar.gz
*.rar
# the Gradle wrapper jar is ours to ship, and it is what makes ./gradlew work for anyone who clones this
!gradle/wrapper/gradle-wrapper.jar
# decompiler, and third party build tooling
tools/*-sources.jar
tools/mdk*.zip

# ==========================================================================================
# Derived material - reproducible, not committed
# ==========================================================================================
# Decompiled and extracted third party sources: several hundred megabytes of someone else's code, all of it
# regenerated by running tools/decompile*.ps1 and tools/extract*.ps1 against the jars above.
tools/src/
tools/src-fd/
tools/src-kc/
tools/nf-src/
tools/extract/
tools/mdk/
tools/mdk-src/

# Generator output that is not part of the mod: magnified preview sheets, logs and work files. Everything the mod
# actually ships lives under src/main/resources, and that IS committed.
tools/out/
tools/*.log

# The source data the generators read, and the input art for the mooncake textures, are inputs rather than
# derived output - nothing can be regenerated without them, so they are kept.
!mooncake.png
!tools/items.tsv
!tools/mooncake-items.tsv
!tools/extra-lang.tsv
!tools/plant-suffix.tsv
!tools/sapling-suffix.tsv
!tools/fruitbush-lang.tsv
